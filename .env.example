# ─────────────────────────────────────────────────────────────
#  FinSuite — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key — generate a strong random value for production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database — leave blank to use local SQLite (development)
# For Railway/Render, set this to the Postgres URL they provide
DATABASE_URL=

# Polygon.io API key — used for news & sentiment data
# Get a free key at https://polygon.io
POLYGON_API_KEY=your-polygon-api-key-here

# FRED API key — used for macroeconomic data
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here
